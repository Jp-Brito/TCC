{
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        },
        {
          "key": "Service-Worker-Allowed",
          "value": "/"
        }
      ]
    },
    {
      "source": "/manifest.webmanifest",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/manifest+json"
        }
      ]
    }
  ],
  "functions": {
    "api/previsao.js": {
      "includeFiles": "data/gtfs/routes.txt"
    },
    "api/tracado.js": {
      "includeFiles": "data/tracados.json"
    },
    "api/paradas-linha.js": {
      "includeFiles": "data/{gtfs/trips.txt,gtfs/stop_times.txt,tracados.json,stops.json}"
    },
    "api/programacao.js": {
      "includeFiles": "data/{gtfs/routes.txt,gtfs/trips.txt,gtfs/stop_times.txt,gtfs/frequencies.txt,gtfs/calendar.txt}"
    },
    "api/trilhos.js": {
      "includeFiles": "data/{tracados.json,stops.json,gtfs/routes.txt,gtfs/trips.txt,gtfs/stop_times.txt,gtfs/frequencies.txt,gtfs/calendar.txt}"
    }
  },
  "regions": [
    "gru1"
  ]
}
