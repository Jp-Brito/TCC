{
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        },
        {
          "key": "Service-Worker-Allowed",
          "value": "/"
        }
      ]
    },
    {
      "source": "/manifest.webmanifest",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/manifest+json"
        }
      ]
    }
  ],
  "functions": {
    "api/previsao.js": {
      "includeFiles": "data/gtfs/routes.txt"
    },
    "api/tracado.js": {
      "includeFiles": "data/tracados.json"
    }
  },
  "regions": ["iad1"]
}